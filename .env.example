# ===== BẮT BUỘC =====
# Khóa API Anthropic — lấy tại console.anthropic.com
# TUYỆT ĐỐI không commit file .env thật (chứa khóa thật) lên git
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== TÙY CHỌN =====
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000
NODE_ENV=production

# CHỈ CẦN THIẾT nếu bạn muốn cho phép một domain KHÁC (không phải domain đang chạy app này)
# gọi thẳng vào API — ví dụ tách frontend/backend ra 2 domain riêng.
# Mặc định (để trống) là đủ dùng: server tự động cho phép domain đang phục vụ chính nó
# (localhost khi chạy local, domain Vercel/custom domain thật khi deploy) — không cần khai báo tay.
# Nếu cần thêm domain phụ, liệt kê ở đây, cách nhau bởi dấu phẩy: https://a.com,https://b.com
ALLOWED_ORIGINS=

# Giới hạn số request trong 15 phút / mỗi địa chỉ IP — chống spam & lạm dụng chi phí API
RATE_LIMIT_CHAT=40
RATE_LIMIT_GENERATE=15

# Tùy chọn: khóa dùng chung để chặn bớt việc người lạ gọi thẳng API khi deploy công khai.
# Để trống = tắt tính năng này. Nếu bật, phải sửa APP_KEY tương ứng trong public/js/config.js
APP_SHARED_KEY=
